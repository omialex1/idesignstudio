generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  COD
  PAID
  FAILED
  CANCELED
}

enum PaymentMethod {
  CARD
  COD
}

// Top-level categories shown in the menu (Events, Handmade, ...). They own the
// subcategories below. Managed from the admin.
model MainCategory {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  sortOrder    Int                       @default(0)
  // Key into lib/category-colors.ts: colour of the placeholder tiles.
  color        String                    @default("salamander")
  // True when products here are made to order in a colour the customer picks
  // (3D-printed items). Only such categories show colours, in admin and shop.
  usesColors   Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  translations MainCategoryTranslation[]
  categories   Category[]
  colors       Color[]
}

// A colour customers can pick for products of one main category (a filament
// colour for 3D prints). `slug` is stored on orders, so it never changes.
model Color {
  id             String       @id @default(cuid())
  slug           String       @unique
  mainCategoryId String
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  nameRo         String
  nameEn         String
  // "#RRGGBB"; drawn as a round swatch unless a photo swatch exists
  hex            String
  // true: use the texture photo public/colors/<slug>.webp instead of the hex
  swatchImage    Boolean      @default(false)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([mainCategoryId])
}

model MainCategoryTranslation {
  id             String       @id @default(cuid())
  mainCategoryId String
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  locale         String
  name           String
  headline       String?
  description    String?

  @@unique([mainCategoryId, locale])
  @@index([locale])
}

// A subcategory: belongs to one main category and holds products.
model Category {
  id             String                @id @default(cuid())
  mainCategoryId String?
  mainCategory   MainCategory?         @relation(fields: [mainCategoryId], references: [id])
  slug           String                @unique
  sortOrder      Int                   @default(0)
  heroImageUrl   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  translations   CategoryTranslation[]
  products       Product[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?

  @@unique([categoryId, locale])
  @@index([locale])
}

model Product {
  id              String               @id @default(cuid())
  categoryId      String
  category        Category             @relation(fields: [categoryId], references: [id])
  slug            String               @unique
  priceCents      Int
  currency        String               @default("RON")
  isActive        Boolean              @default(true)
  hasColorOptions Boolean              @default(true)
  // Slugs of colours of the category that THIS product does not offer. Empty: the
  // customer can pick any active colour of the category (new colours included).
  excludedColors  String[]             @default([])
  // Price depends on how many pieces are bought: the variants are then price
  // tiers (minQuantity + unit price) that the customer cannot pick, only read.
  tieredPricing   Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  variants        ProductVariant[]
  components      ProductComponent[]
  translations    ProductTranslation[]
  images          ProductImage[]
  inventory       Inventory?
  orderItems      OrderItem[]
  groupItems      ProductGroupItem[]
}

model ProductVariant {
  id              String             @id @default(cuid())
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder       Int                @default(0)
  nameRo          String
  nameEn          String?
  priceCents      Int
  // Optional % taken off priceCents (used for sets).
  discountPercent Int                @default(0)
  // For tiered products: smallest quantity that gets this unit price.
  minQuantity     Int?
  // Pieces of this variant, each with its own colour choice.
  components      ProductComponent[]

  @@unique([productId, sortOrder])
}

model ProductComponent {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Set for pieces that belong to one variant; null = piece of a product
  // that has no variants.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)
  nameRo    String
  nameEn    String?
  maxColors Int             @default(1)

  @@unique([productId, sortOrder])
}

model ProductTranslation {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale          String
  name            String
  description     String?
  longDescription String?

  @@unique([productId, locale])
  @@index([locale])
}

// A set of products chosen together. "recommended" groups feed the "Merge bine cu"
// row on the product page; "promo" groups are internal (for promotions later).
model ProductGroup {
  id        String             @id @default(cuid())
  name      String
  // "recommended" or "promo"
  kind      String             @default("recommended")
  // optional cap on the number of products (null: no limit)
  maxItems  Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  items     ProductGroupItem[]
}

model ProductGroupItem {
  id        String       @id @default(cuid())
  groupId   String
  group     ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  // the order the products were chosen in (and are shown in)
  sortOrder Int          @default(0)

  @@unique([groupId, productId])
  @@index([productId])
}

model ProductImage {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int               @default(0)
  data      ProductImageData?
}

model ProductImageData {
  id          String       @id @default(cuid())
  imageId     String       @unique
  image       ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
}

model Inventory {
  id                String  @id @default(cuid())
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand    Int     @default(0)
  reservedQty       Int     @default(0)
  lowStockThreshold Int     @default(5)
}

model Order {
  id                String        @id @default(cuid())
  ntpId             String?       @unique
  customerEmail     String
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  firstName         String
  lastName          String
  phone             String
  addressLine       String
  city              String
  county            String
  postalCode        String
  country           String        @default("RO")
  notes             String?
  companyName       String?
  companyCui        String?
  paymentMethod     PaymentMethod @default(CARD)
  status            OrderStatus   @default(PENDING)
  subtotalCents     Int
  shippingCents     Int
  codFeeCents       Int           @default(0)
  totalCents        Int
  currency          String        @default("RON")
  locale            String
  termsAcceptedAt   DateTime
  paidAt            DateTime?
  // True when the customer wrote a locality that is not in our list; Bea checks it before shipping
  addressUnverified Boolean       @default(false)
  // Oblio invoice made by hand from the admin (button "Genereaza factura")
  invoiceSeries     String?
  invoiceNumber     String?
  invoiceUrl        String?
  invoicedAt        DateTime?
  // set while the invoice is being made, so two clicks cannot make two invoices
  invoiceClaimedAt  DateTime?
  invoiceError      String?
  // Bea marked the order as finished (for example shipped)
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
}

model Customer {
  id              String                   @id @default(cuid())
  email           String                   @unique
  passwordHash    String
  name            String
  locale          String                   @default("ro")
  // Saved contact and delivery details, used to prefill the checkout
  phone           String?
  addressLine     String?
  city            String?
  county          String?
  postalCode      String?
  // Set when the customer clicks the link sent to their e-mail
  emailVerifiedAt DateTime?
  // Raised when the password changes, so older logins stop working
  sessionVersion  Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  orders          Order[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productNameSnapshot String
  variantName         String?
  colors              String[]
  colorChoices        Json?
  colorNote           String?
  unitPriceCents      Int
  quantity            Int
}

model AdminCredential {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Counters for the limits on login, sign-up, checkout and similar. The key is a
// hash (action + IP / e-mail / phone), never the raw value; rows older than a
// day are removed.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// People who can use the admin panel (stage 1 of the admin accounts: each
// person has their own login, with a short username shown in the activity log).
model AdminUser {
  id             String            @id @default(cuid())
  // as written ("Bea"), shown in the activity log
  username       String
  // lower-case, used to log in and to keep names unique
  usernameKey    String            @unique
  email          String            @unique
  // empty until the invitation has been accepted
  passwordHash   String?
  // the owner is the only one who can invite, deactivate and delete admin accounts
  isOwner        Boolean           @default(false)
  isActive       Boolean           @default(true)
  // raised when the password changes, so older logins stop working
  sessionVersion Int               @default(0)
  lastLoginAt    DateTime?
  // Two-step login (authenticator app). The secret is stored encrypted and only
  // counts once totpEnabledAt is set (the person has proved their app works).
  totpSecret     String?
  totpEnabledAt  DateTime?
  // time step of the last accepted code, so a code cannot be used twice
  totpLastStep   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tokens         AdminUserToken[]
  devices        AdminDevice[]
  logs           AdminLog[]
  backupCodes    AdminBackupCode[]
}

// Single-use links sent by e-mail: the invitation to a new account and the
// password reset. Stored hashed, like the customers' tokens.
model AdminUserToken {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  // "invite" or "reset"
  kind        String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// Browsers a person has already logged in from (by a hash of a random id kept in
// a cookie); a login from an unknown one sends a warning e-mail.
model AdminDevice {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  deviceHash  String
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@unique([adminUserId, deviceHash])
}

// Who did what in the admin panel. The username is copied into the row, so the
// history stays readable even if the account is deleted later.
model AdminLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  username    String
  action      String
  detail      String?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
}

// One-time codes for when the authenticator app is not at hand. Stored only as
// a keyed hash; each works once.
model AdminBackupCode {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}
