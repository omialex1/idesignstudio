generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  COD
  PAID
  FAILED
  CANCELED
}

enum PaymentMethod {
  CARD
  COD
}

// Top-level categories shown in the menu (Events, Handmade, ...). They own the
// subcategories below. Managed from the admin.
model MainCategory {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  sortOrder    Int                       @default(0)
  // Key into lib/category-colors.ts: colour of the placeholder tiles.
  color        String                    @default("salamander")
  // True when products here are made to order in a colour the customer picks
  // (3D-printed items). Only such categories show colours, in admin and shop.
  usesColors   Boolean                   @default(false)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  translations MainCategoryTranslation[]
  categories   Category[]
  colors       Color[]
}

// A colour customers can pick for products of one main category (a filament
// colour for 3D prints). `slug` is stored on orders, so it never changes.
model Color {
  id             String       @id @default(cuid())
  slug           String       @unique
  mainCategoryId String
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  nameRo         String
  nameEn         String
  // "#RRGGBB"; drawn as a round swatch unless a photo swatch exists
  hex            String
  // true: use the texture photo public/colors/<slug>.webp instead of the hex
  swatchImage    Boolean      @default(false)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([mainCategoryId])
}

model MainCategoryTranslation {
  id             String       @id @default(cuid())
  mainCategoryId String
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  locale         String
  name           String
  headline       String?
  description    String?

  @@unique([mainCategoryId, locale])
  @@index([locale])
}

// A subcategory: belongs to one main category and holds products.
model Category {
  id             String                @id @default(cuid())
  mainCategoryId String?
  mainCategory   MainCategory?         @relation(fields: [mainCategoryId], references: [id])
  slug           String                @unique
  sortOrder      Int                   @default(0)
  heroImageUrl   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  translations   CategoryTranslation[]
  products       Product[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?

  @@unique([categoryId, locale])
  @@index([locale])
}

model Product {
  id              String               @id @default(cuid())
  categoryId      String
  category        Category             @relation(fields: [categoryId], references: [id])
  slug            String               @unique
  priceCents      Int
  currency        String               @default("RON")
  isActive        Boolean              @default(true)
  hasColorOptions Boolean              @default(true)
  // Price depends on how many pieces are bought: the variants are then price
  // tiers (minQuantity + unit price) that the customer cannot pick, only read.
  tieredPricing   Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  variants        ProductVariant[]
  components      ProductComponent[]
  translations    ProductTranslation[]
  images          ProductImage[]
  inventory       Inventory?
  orderItems      OrderItem[]
}

model ProductVariant {
  id              String             @id @default(cuid())
  productId       String
  product         Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder       Int                @default(0)
  nameRo          String
  nameEn          String?
  priceCents      Int
  // Optional % taken off priceCents (used for sets).
  discountPercent Int                @default(0)
  // For tiered products: smallest quantity that gets this unit price.
  minQuantity     Int?
  // Pieces of this variant, each with its own colour choice.
  components      ProductComponent[]

  @@unique([productId, sortOrder])
}

model ProductComponent {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Set for pieces that belong to one variant; null = piece of a product
  // that has no variants.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)
  nameRo    String
  nameEn    String?
  maxColors Int             @default(1)

  @@unique([productId, sortOrder])
}

model ProductTranslation {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale          String
  name            String
  description     String?
  longDescription String?

  @@unique([productId, locale])
  @@index([locale])
}

model ProductImage {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int               @default(0)
  data      ProductImageData?
}

model ProductImageData {
  id          String       @id @default(cuid())
  imageId     String       @unique
  image       ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
}

model Inventory {
  id                String  @id @default(cuid())
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand    Int     @default(0)
  reservedQty       Int     @default(0)
  lowStockThreshold Int     @default(5)
}

model Order {
  id                String        @id @default(cuid())
  ntpId             String?       @unique
  customerEmail     String
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  firstName         String
  lastName          String
  phone             String
  addressLine       String
  city              String
  county            String
  postalCode        String
  country           String        @default("RO")
  notes             String?
  companyName       String?
  companyCui        String?
  paymentMethod     PaymentMethod @default(CARD)
  status            OrderStatus   @default(PENDING)
  subtotalCents     Int
  shippingCents     Int
  codFeeCents       Int           @default(0)
  totalCents        Int
  currency          String        @default("RON")
  locale            String
  termsAcceptedAt   DateTime
  paidAt            DateTime?
  // True when the customer wrote a locality that is not in our list; Bea checks it before shipping
  addressUnverified Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
}

model Customer {
  id              String                   @id @default(cuid())
  email           String                   @unique
  passwordHash    String
  name            String
  locale          String                   @default("ro")
  // Saved contact and delivery details, used to prefill the checkout
  phone           String?
  addressLine     String?
  city            String?
  county          String?
  postalCode      String?
  // Set when the customer clicks the link sent to their e-mail
  emailVerifiedAt DateTime?
  // Raised when the password changes, so older logins stop working
  sessionVersion  Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  orders          Order[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productNameSnapshot String
  variantName         String?
  colors              String[]
  colorChoices        Json?
  colorNote           String?
  unitPriceCents      Int
  quantity            Int
}

model AdminCredential {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Counters for the limits on login, sign-up, checkout and similar. The key is a
// hash (action + IP / e-mail / phone), never the raw value; rows older than a
// day are removed.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
